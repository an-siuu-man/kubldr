# Copy this file to .env and fill in real values.
# NEVER commit .env — it is listed in .gitignore.
# Only this .env.example file (with placeholder values) is committed.

# Supabase project URL — found in your Supabase dashboard under Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous (public) key — safe to expose in the browser
# Found in your Supabase dashboard under Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public base URL used for server-side redirects (e.g. auth callbacks)
NEXT_PUBLIC_URL=http://localhost:3000
